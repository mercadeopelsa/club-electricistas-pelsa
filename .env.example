PORT=4173
HOST=127.0.0.1
APP_URL=http://localhost:4173
DATA_DIR=./data
# Generate with npm run setup; keep this key with your backups.
DATA_KEY=
# Set to true ONLY behind HTTPS in production.
COOKIE_SECURE=false
# Enable only when exactly one trusted reverse proxy fronts the app.
TRUST_PROXY=false

# Mensajería: disabled (sin envíos), test (simulada) o twilio (producción).
MESSAGING_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS: usa un Messaging Service SID o un número remitente.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
# Número habilitado por Twilio para WhatsApp, por ejemplo +15017122661.
TWILIO_WHATSAPP_FROM=

